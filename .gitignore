# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite database file — generated by `npm run seed` / `prisma migrate`,
# not source. Migrations in prisma/migrations/ ARE committed.
/prisma/*.db
/prisma/*.db-journal

# Downloaded AI-tooling skill docs (Prisma CLI reference etc.) — local
# tooling cache, not project source. /.claude/skills/* are symlinks into it.
/.agents/
/.claude/skills/
/.windsurf/

# Obsidian's own per-vault settings (theme, enabled plugins, open panes,
# local cache) for the docs/ vault — personal workspace state, not content.
/docs/.obsidian/
